{
  "name": "@vizij/test-fixtures",
  "version": "0.0.2",
  "private": true,
  "description": "Shared test fixtures for Vizij Rust + npm packages.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shared/browser": {
      "browser": "./dist/shared.browser.js",
      "import": "./dist/shared.browser.js",
      "default": "./dist/shared.browser.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/generate-browser-fixtures.mjs && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^24.19.2"
  }
}
