/// Start one App rendering the face in `canvas` (a CSS selector) from the
/// GLB `glb` (bytes from JS), with the device composed from its bundle.
#[wasm_bindgen]
pub fn start(canvas: String, glb: &[u8]) -> Result<(), JsValue> {
    if RUNNING.load(Ordering::SeqCst) {
        return Err(JsValue::from_str("already running; stop() first"));
    }
    let meta = FaceMeta::from_glb_bytes(glb).map_err(|e| JsValue::from_str(&e))?;
    console_log(&format!(
        "challenge-wasm: face {:?}: {} elements, {} animatables, bounds {:?}, {} graphs, {} neutral inputs",
        meta.bundle.face_id,
        meta.elements.len(),
        meta.animatables.len(),
        meta.root_bounds,
        meta.bundle.graphs.len(),
        meta.bundle.neutral_inputs.len()
    ));
    let (arora, rig, rig_prefix) = compose_device(&meta).map_err(|e| JsValue::from_str(&e))?;
    let device = Rc::new(RefCell::new(Device {
        arora,
        rig: rig.clone(),
        rig_prefix,
    }));
    DEVICE.with(|d| *d.borrow_mut() = Some(device.clone()));
    INDEX_READY.store(false, Ordering::SeqCst);
    EXIT_REQUESTED.store(false, Ordering::SeqCst);
    RUNNING.store(true, Ordering::SeqCst);

    // The GLB bytes as an in-memory asset source: `mem://face.glb`.
    let dir = Dir::default();
    dir.insert_asset(Path::new("face.glb"), glb.to_vec());

    let mut app = App::new();
    app.register_asset_source(
        "mem",
        AssetSourceBuilder::new(move || Box::new(MemoryAssetReader { root: dir.clone() })),
    );
    app.add_plugins(
        DefaultPlugins
            .set(WindowPlugin {
                primary_window: Some(Window {
                    title: "Vizij face (challenge-wasm)".into(),
                    canvas: Some(canvas),
                    fit_canvas_to_parent: true,
                    prevent_default_event_handling: false,
                    ..default()
                }),
                ..default()
            })
            .set(AssetPlugin {
                meta_check: AssetMetaCheck::Never,
                ..default()
            }),
    )
    .insert_resource(meta)
    .insert_resource(RigRes(rig))
    .insert_resource(BindingIndex::default())
    .insert_resource(ClearColor(Color::BLACK))
    .insert_non_send_resource(DeviceRes(device))
    .insert_non_send_resource(RunGuard)
    .add_systems(Startup, (setup_scene, setup_camera))
    .add_systems(
        Update,
        (step_device, index_scene, apply_pose, count_frames, request_exit).chain(),
    );
    #[cfg(feature = "picking")]
    {
        app.add_plugins(bevy::picking::mesh_picking::MeshPickingPlugin);
        app.add_observer(on_click);
    }
    // On the web the winit runner spawns the loop and returns at once.
    let exit = app.run();
    console_log(&format!("challenge-wasm: App::run returned: {exit:?}"));
    Ok(())
}

/// Ask the App to exit at its next frame (an `AppExit` message).
#[wasm_bindgen]
pub fn stop() {
    EXIT_REQUESTED.store(true, Ordering::SeqCst);
}

/// True between `start()` and the drop of the App's world.
#[wasm_bindgen]
pub fn running() -> bool {
    RUNNING.load(Ordering::SeqCst)
}

/// True once the scene spawned and its bindings are indexed.
#[wasm_bindgen(js_name = indexReady)]
pub fn index_ready() -> bool {
    INDEX_READY.load(Ordering::SeqCst)
}

/// Frames rendered since `start()`.
#[wasm_bindgen]
pub fn frames() -> u32 {
    FRAMES.load(Ordering::SeqCst)
}

/// Number of entries in the rig's current pose (what the view applies).
#[wasm_bindgen(js_name = poseLen)]
pub fn pose_len() -> Result<usize, JsValue> {
    with_device(|d| Ok(d.rig.pose().len()))
}

/// Write one key into the store; `value_json` is an arora `Value` as JSON
/// (`{"f32": 0.5}`) or a vizij shorthand (`{"float": 0.5}`).
#[wasm_bindgen(js_name = setValue)]
pub fn set_value(path: &str, value_json: &str) -> Result<(), JsValue> {
    let json: Json = serde_json::from_str(value_json)
        .map_err(|e| JsValue::from_str(&format!("value is not JSON: {e}")))?;
    let json = vizij_api_core::json::normalize_value_json(json);
    let value: Value = serde_json::from_value(json)
        .map_err(|e| JsValue::from_str(&format!("not an arora Value: {e}")))?;
    with_device(|d| {
        let mut change = StateChange::new();
        change.set.insert(Key::from(path), Some(value));
        d.arora
            .store()
            .write(change)
            .map_err(|e| format!("write: {e:?}"))
    })
}

/// Read keys from the store: `paths` is a JS `string[]`; the result maps each
/// path to its arora `Value` as a JS object (or `null`).
#[wasm_bindgen(js_name = readValues)]
pub fn read_values(paths: JsValue) -> Result<JsValue, JsValue> {
    let paths: Vec<String> = js_sys::Array::from(&paths)
        .iter()
        .filter_map(|v| v.as_string())
        .collect();
    let keys: Vec<Key> = paths.iter().map(|p| Key::from(p.as_str())).collect();
    let values = with_device(|d| Ok(d.arora.store().read(&keys)))?;
    let out = js_sys::Object::new();
    for (path, value) in paths.iter().zip(values) {
        let json = serde_json::to_string(&value)
            .map_err(|e| JsValue::from_str(&format!("serialize: {e}")))?;
        js_sys::Reflect::set(&out, &JsValue::from_str(path), &js_sys::JSON::parse(&json)?)?;
    }
    Ok(out.into())
}

/// The face's rig prefix (`rig/<faceId>/`).
#[wasm_bindgen(js_name = rigPrefix)]
pub fn rig_prefix() -> Result<String, JsValue> {
    with_device(|d| Ok(d.rig_prefix.clone()))
}

/// Spawn a `play_viseme(shape, weight)` run through the interpreter's SPAWN
/// call (arora-behavior's interpreter module); returns the `TaskHandle` as
/// JSON (`status` key, `stop` call, feedback keys).
#[wasm_bindgen(js_name = spawnPlayViseme)]
pub fn spawn_play_viseme(shape: &str, weight: f32) -> Result<String, JsValue> {
    let call = Call {
        module_id: Some(viseme::MODULE_ID),
        id: viseme::PLAY_VISEME_ID,
        args: vec![
            StructureField {
                id: gen_uuid_from_str("shape"),
                value: Box::new(Value::String(shape.to_string())),
            },
            StructureField {
                id: gen_uuid_from_str("weight"),
                value: Box::new(Value::F32(weight)),
            },
        ],
    };
    with_device(|d| {
        let result = d
            .arora
            .call(interpreter_module::encode_spawn(&call, RunPolicy::Concurrent))
            .map_err(|e| format!("SPAWN failed: {e:?}"))?;
        let handle = interpreter_module::decode_spawn_result(&result.ret)?;
        serde_json::to_string(&handle).map_err(|e| format!("serialize handle: {e}"))
    })
}

/// Halt a run: dispatch the handle's `stop` call; returns the `CallResult`
/// as JSON.
#[wasm_bindgen]
pub fn halt(handle_json: &str) -> Result<String, JsValue> {
    let handle: TaskHandle = serde_json::from_str(handle_json)
        .map_err(|e| JsValue::from_str(&format!("not a TaskHandle: {e}")))?;
    with_device(|d| {
        let result = d
            .arora
            .call(handle.stop.clone())
            .map_err(|e| format!("HALT failed: {e:?}"))?;
        serde_json::to_string(&result).map_err(|e| format!("serialize result: {e}"))
    })
}

/// The clicks recorded since the last call, as JSON strings (feature
/// `picking`).
#[wasm_bindgen(js_name = drainClicks)]
pub fn drain_clicks() -> JsValue {
    let clicks: Vec<String> = std::mem::take(&mut *CLICKS.lock().unwrap());
    let arr = js_sys::Array::new();
    for c in clicks {
        arr.push(&JsValue::from_str(&c));
    }
    arr.into()
}

/// A JS function called with each click's JSON (feature `picking`).
#[wasm_bindgen(js_name = setClickCallback)]
pub fn set_click_callback(callback: js_sys::Function) {
    CLICK_CALLBACK.with(|c| *c.borrow_mut() = Some(callback));
}

