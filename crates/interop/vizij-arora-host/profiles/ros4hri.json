{
  "id": "ros4hri",
  "version": "v1",
  "title": "ROS4HRI face command",
  "description": "The ROS4HRI face interface: expression name with valence and arousal, a gaze target and its frame, and the streamed viseme commanded; the utterance being spoken and its current viseme reported.",
  "scope": "device",
  "keys": [
    {
      "path": "standard/ros4hri/expression/name",
      "kind": "input",
      "value_type": "str",
      "default_value": {
        "str": ""
      }
    },
    {
      "path": "standard/ros4hri/expression/valence",
      "kind": "input",
      "value_type": "f32",
      "min": -1.0,
      "max": 1.0,
      "default_value": {
        "f32": 0.0
      }
    },
    {
      "path": "standard/ros4hri/expression/arousal",
      "kind": "input",
      "value_type": "f32",
      "min": -1.0,
      "max": 1.0,
      "default_value": {
        "f32": 0.0
      }
    },
    {
      "path": "standard/ros4hri/gaze/target",
      "kind": "input",
      "value_type": "struct"
    },
    {
      "path": "standard/ros4hri/gaze/frame",
      "kind": "input",
      "value_type": "str",
      "default_value": {
        "str": ""
      }
    },
    {
      "path": "standard/ros4hri/viseme",
      "kind": "input",
      "value_type": "u8",
      "min": 0.0,
      "max": 14.0,
      "default_value": {
        "u8": 0
      }
    },
    {
      "path": "standard/ros4hri/viseme/time",
      "kind": "input",
      "value_type": "f32",
      "min": 0.0,
      "default_value": {
        "f32": 0.0
      }
    },
    {
      "path": "standard/ros4hri/viseme/duration",
      "kind": "input",
      "value_type": "f32",
      "min": 0.0,
      "default_value": {
        "f32": 0.0
      }
    },
    {
      "path": "standard/ros4hri/speech/text",
      "kind": "output",
      "value_type": "str",
      "default_value": {
        "str": ""
      }
    },
    {
      "path": "standard/ros4hri/speech/viseme",
      "kind": "output",
      "value_type": "str",
      "default_value": {
        "str": "sil"
      }
    }
  ]
}
